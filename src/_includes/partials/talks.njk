<h2 class="section-rule"><span class="section-rule-label">{% icon "mdi:microphone" %}Invited Talks</span></h2>
<div class="ref-list">
  {% for t in talks %}
    <p class="ref-entry"><span class="talk-title">"{{ t.title }}."</span> <span class="pub-venue">{{ t.venue }}</span>{% if t.location %}, {{ t.location }}{% endif %} ({{ t.year }}).</p>
  {% endfor %}
</div>
