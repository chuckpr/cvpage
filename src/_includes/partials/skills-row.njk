<div class="section-block">
  <h2 class="section-rule"><span class="section-rule-label">{% icon "mdi:hammer-wrench" %}Skills</span></h2>
  <div class="skill-clusters">
    {%- for cluster in variant.skillClusters %}
    <div class="skill-cluster">
      <span class="skill-cluster-label">{{ cluster.label }}</span>
      <span class="skill-cluster-items">{% for it in cluster.items %}<span class="skill">{{ it }}</span>{{ " · " if not loop.last }}{% endfor %}</span>
    </div>
    {%- endfor %}
  </div>
</div>
