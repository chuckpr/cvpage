<h2 class="section-rule"><span class="section-rule-label">{% icon "mdi:file-document-outline" %}Selected Publications</span></h2>
<div class="ref-list">
  {% for p in pubs %}
    <p class="ref-entry">{{ p.authors | safe }}. "{{ p.title }}." <span class="pub-venue">{{ p.venue }}</span> ({{ p.year }}){% if p.note %} · <span class="pub-note">{{ p.note }}</span>{% endif %}.</p>
  {% endfor %}
</div>
