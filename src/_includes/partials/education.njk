<h2 class="section-rule"><span class="section-rule-label">{% icon sectionIcon %}{{ sectionTitle }}</span></h2>
<div class="timeline">
  {% for institution, degrees in items | groupby("institution") %}
    <div class="timeline-item">
      <div class="timeline-dot"></div>
      <h3 class="role-org">{{ institution }}</h3>
      <div class="edu-degrees">
        {% for d in degrees %}
        <div class="edu-degree">
          <span class="edu-degree-name">{{ d.degree }}, {{ d.field }}</span>
          {%- if d.notes and d.notes.length %} <span class="edu-note">| {{ d.notes | join("; ") }}</span>{% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>
