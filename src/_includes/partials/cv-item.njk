<h2 class="section-rule"><span class="section-rule-label">{% icon sectionIcon %}{{ sectionTitle }}</span></h2>
<div class="timeline">
  {% for item in items %}
    <div class="timeline-item">
      <div class="timeline-dot"></div>
      <div class="role-header">
        <h3 class="role-org">{{ item.organization }}</h3>
        <span class="role-dates">{{ item.begin + "–" + item.end }}</span>
      </div>
      {# A variant may override a role title per company via variant.titles[id]
         (e.g. present an IC-oriented title); otherwise use the shared title. #}
      {% set roleTitle = item.title %}
      {% if variant.titles and variant.titles[item.id] %}{% set roleTitle = variant.titles[item.id] %}{% endif %}
      <div class="role-subhead">
        <h4 class="role-title">{{ roleTitle }}</h4>
        {% if item.location and item.location.trim() %}
          <span class="role-location">{{ item.location }}</span>
        {% endif %}
      </div>
      {% set notes = item.bullets | pick(variant.select[item.id]) %}
      {% if notes and notes.length > 0 %}
        <div class="note-body">
          <ul class="note-list">
            {% for note in notes %}
              <li>{{ note | noteText(variant.textVariant) }}
                {% if note.children and note.children.length %}
                  <ul class="note-sublist">
                    {% for child in note.children %}<li>{{ child | noteText(variant.textVariant) }}</li>{% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>
