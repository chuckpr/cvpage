---
layout: layouts/base.njk
pagination:
  data: renderVariants
  size: 1
  alias: variant
permalink: "{{ variant.permalink }}"
---

{% set pubs = publications | pick(variant.publications) %}
{% set talks = talks | pick(variant.talks) %}

<div class="sheet-outer letter">
<div class="pdf-download-row">
  <a href="{{ ('/resume-' + variant.key + '.pdf') | url }}" class="pdf-download">Download PDF</a>
</div>

{# Page 1 — main résumé. Its sections space out vertically to fill the page. #}
<div class="sheet sheet--fill">
<div class="resume-body resume-body--fill">

<div id="intro" class="intro">
  <div class="intro-header">
    <h1 class="resume-name">{{ profile.name }}</h1>
    <span class="resume-title">{{ variant.profile.title | safe }}</span>
  </div>
  {% if profile.location %}<div class="resume-location">{{ profile.location }}</div>{% endif %}
  <p class="resume-summary">{{ variant.profile.description }}</p>
  {% include "partials/contact-row.njk" %}
</div>

{% include "partials/skills-row.njk" %}

<div class="section-block">
  {% set items = experience | section("experience") | selected(variant.select) | sortByDateDesc %}
  {% set sectionTitle = "Experience" %}
  {% set sectionIcon = "mdi:office-building" %}
  {% include "partials/cv-item.njk" %}
</div>

{% set teaching = experience | section("teaching") | selected(variant.select) | sortByDateDesc %}
{% if teaching and teaching.length %}
<div class="section-block">
  {% set items = teaching %}
  {% set sectionTitle = "Teaching" %}
  {% set sectionIcon = "mdi:human-male-board" %}
  {% include "partials/cv-item.njk" %}
</div>
{% endif %}

<div class="section-block">
  {% set items = education | sortByDateDesc %}
  {% set sectionTitle = "Education" %}
  {% set sectionIcon = "mdi:school" %}
  {% include "partials/education.njk" %}
</div>

</div>
</div>

{# Page 2 — back matter (publications, invited talks). Flows across pages if
   long; only rendered when the variant selects something to show. #}
{% if (pubs and pubs.length) or (talks and talks.length) %}
<div class="sheet">
<div class="resume-body">
  {% if pubs and pubs.length %}
  <div class="section-block">
    {% include "partials/publications.njk" %}
  </div>
  {% endif %}
  {% if talks and talks.length %}
  <div class="section-block">
    {% include "partials/talks.njk" %}
  </div>
  {% endif %}
</div>
</div>
{% endif %}

</div>
